datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
}

model User {
  id               String            @id @default(uuid())
  googleId         String?           @unique
  name             String
  email            String            @unique
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senders          Sender[]
  emails           Email[]
  slackConnections SlackConnection[]
}

model Sender {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  smtpUser     String
  smtpPassword String
  smtpHost     String
  smtpPort     Int
  createdAt    DateTime @default(now())
  emails       Email[]
}

model Email {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId    String
  sender      Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipient   String
  subject     String
  body        String      @db.Text
  scheduledAt DateTime
  sentAt      DateTime?
  status      EmailStatus @default(scheduled)
  jobId       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([senderId])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String
  teamId      String
  teamName    String
  slackUserId String?
  channelId   String?
  channelName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
